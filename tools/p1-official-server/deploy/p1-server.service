# @HOME@ stands for the trader home directory and is replaced by sed at
# install time, since %h in a system unit resolves to root's home.

[Unit]
Description=Official shioaji server for the P1 soak

# A login attempted before the network is up fails without exiting
Wants=network-online.target
After=network-online.target

[Service]
User=trader
UMask=0077
WorkingDirectory=~
EnvironmentFile=@HOME@/.sinopac-p1/host.env
EnvironmentFile=@HOME@/.sinopac-p1/secrets.env

# Doubled dollar signs reach the shell as single ones so the shell expands
# P1_SERVER_LOG, and exec keeps shioaji as the main process.
ExecStart=/bin/sh -c 'mkdir -p -m 0700 "$$(dirname "$$P1_SERVER_LOG")" && exec @HOME@/.local/bin/shioaji server start --no-open >> "$$P1_SERVER_LOG" 2>&1'

# Only a process exit restarts it, a login failure that leaves it running does not
Restart=on-failure
RestartSec=30
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
