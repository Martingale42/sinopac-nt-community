# Template for host.env, which holds host-specific values and no secrets,
# paths are absolute because EnvironmentFile= does not expand ~ or $HOME,
# and @HOME@ is replaced with the trader home directory when installed.

# Path of the CA certificate the official server loads at startup
SJ_CA_PATH=@HOME@/.sinopac-p1/ca.pfx

# Directory for the official server's state, including its token cache
SJ_HOME_PATH=@HOME@/.sinopac-p1/home

# Address the official server listens on, loopback only
SJ_HTTP_ADDR=127.0.0.1:18080

# Egress IPv4 the broker allowlist expects, comma-separated for several
P1_EGRESS_IP=203.0.113.10

# Official server log file, its directory is created by p1-server.service
P1_SERVER_LOG=@HOME@/sinopac-nt-community/results/p1/2026-10-07-server/server.log

# Time the recorder stops by itself, with a UTC offset
P1_STREAM_UNTIL=2026-10-14T20:00:00+08:00

# Exchange closed dates as YYYY-MM-DD, comma-separated, empty for none
P1_MARKET_HOLIDAYS=2026-10-09,2026-10-10
